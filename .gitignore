# The snapshot is the DATA, and it spans every project named in
# CAMBIUM_PROJECTS — including private repos and ones with no remote. The site
# in this directory is just code and is safe to publish; this file is not.
# Regenerate it with:  cambium-mcp export-snapshot --out snapshot.json --bodies
snapshot.json

# Exported pages are full entry prose from every named project. Same rule as the
# snapshot: this is the data, not the code.
# Regenerate with:  cambium-mcp export-pages --out vault
vault/

# The publishable bundle. Contains snapshot.json, so it is data too.
# Rebuild with:  python tools/build_dist.py
dist/

# wrangler's local state and build cache.
.wrangler/

# The path-token credential lives in ~/.xylem-dashboard-token, never in the
# repo. wrangler holds the deployed copy as a Worker secret.
*.token

# cambium's local knowledge store. Never tracked in ANY repo (con-004-e3b9,
# con-017-9acb): it aggregates knowledge across every project on the machine,
# including private ones.
.cambium/

__pycache__/
